{
    "name": "smcothrift/donation-manager",
    "description": "WordPress plugin for handling donations",
    "homepage": "https://github.com/SMCoThrift/donation-manager",
    "type": "wordpress-plugin",
    "require": {
        "zordius/lightncandy": "^1.2",
        "collizo4sky/persist-admin-notices-dismissal": "^1.4",
        "a5hleyrich/wp-background-processing": "^1.0",
        "php": ">=8.0",
        "mwender/php-form": "dev-master",
        "mwender/cloudinary_php": "dev-main"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Wender",
            "email": "mwender@wenmarkdigital.com",
            "homepage": "https://wenmarkdigital.com"
        }
    ],
    "repositories": {
        "0": {
            "type": "vcs",
            "url": "https://github.com/mwender/php-form"
        },
        "1": {
            "type": "vcs",
            "url": "git@github.com:mwender/cloudinary_php.git"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "wpreadme2markdown/wp2md": "^4.3"
    },
    "scripts": {
        "readme": "wp2md -i readme.txt -o README.md",
        "makepot": "wp i18n make-pot . languages/donation-manager.pot --domain=donation-manager --exclude=node_modules,vendor,tests"
    }
}
